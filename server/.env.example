# ─────────────────────────────────────────────────
#  CCCP_Amazon Server — Environment Variables
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ─────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── MySQL Database ────────────────────────────────
# If using XAMPP:  DB_PORT=3306, DB_USER=root, DB_PASSWORD=(blank)
# If using Docker: DB_PORT=3307 (see docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cccp_amazon

# ── CORS ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── JWT ───────────────────────────────────────────
# CHANGE THIS to any long random string (32+ chars)
JWT_SECRET=change_me_to_a_long_random_secret_32chars_min
JWT_EXPIRES_IN=24h

# ── File Uploads ──────────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
ENABLE_RATE_LIMIT=false
