# Production Server Environment Variables
PORT=5000
NODE_ENV=production

# Production MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cccp_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=cccp_amazon

# Production JWT Configuration (Use a cryptographically secure 64+ char key)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_64_CHARS
JWT_EXPIRES_IN=24h

# File Upload Constraints
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Allowed Frontend Origins (Comma separated or specific domain)
CORS_ORIGIN=https://amazon.yourdomain.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
ENABLE_RATE_LIMIT=true

